---
import Kicker from "./Kicker.astro";

const steps = [
  {
    number: "01",
    title: "Elegís",
    description:
      "Mirá la lista y decinos qué le hace falta a tu capy. Una sola cosa también vale.",
  },
  {
    number: "02",
    title: "Te lo mandamos",
    description:
      "Coordinamos el envío por mail. Por ahora es una conversación, no un checkout.",
  },
  {
    number: "03",
    title: "Tu capy descansa",
    description:
      "Agua, pasto, sombra. Nosotros nos ocupamos de las cosas; el resto es siesta.",
  },
];
---

<section class="bg-sand px-5 py-[4.4rem]" id="como-funciona">
  <div class="mx-auto max-w-[1120px]">
    <div
      class="mb-7 grid grid-cols-1 items-end gap-4 min-[901px]:grid-cols-[1fr_auto]"
    >
      <div>
        <Kicker>Sin vueltas</Kicker>
        <h2
          class="m-0 font-serif text-[clamp(2rem,3.6vw,3.1rem)] font-[560] tracking-tight text-forest"
        >
          Elegís, te lo mandamos, tu capy descansa.
        </h2>
      </div>
      <p class="m-0 max-w-[18rem] text-[0.88rem] text-forest-mid">
        En este borrador el pedido es un mail. Todavía no hay cobro ni envío real.
      </p>
    </div>

    <div
      class="grid grid-cols-1 gap-4 min-[721px]:grid-cols-2 min-[901px]:grid-cols-3"
    >
      {
        steps.map((step) => (
          <article class="rounded-[1.1rem] border border-line bg-paper px-5 py-5">
            <strong
              class="mb-3 block font-serif text-[2rem] font-medium italic leading-none text-terra"
            >
              {step.number}
            </strong>
            <h3 class="m-0 mb-1.5 font-serif text-[1.45rem] font-[560] tracking-tight text-forest">
              {step.title}
            </h3>
            <p class="m-0 text-muted">{step.description}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
