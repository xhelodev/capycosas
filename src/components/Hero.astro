---
import Kicker from "./Kicker.astro";
import Button from "./Button.astro";
---

<section class="px-5 pb-[4.2rem] pt-[3.2rem] max-[720px]:pt-6" id="inicio">
  <div
    class="mx-auto grid max-w-[1120px] grid-cols-1 items-end gap-10 min-[901px]:grid-cols-[minmax(0,0.92fr)_minmax(0,1.15fr)]"
  >
    <div class="max-[720px]:order-2">
      <Kicker>Para capibaras, no para humanos</Kicker>
      <h1
        class="m-0 mb-4 font-serif text-[clamp(2.6rem,5.4vw,4.6rem)] font-[560] leading-[1.08] tracking-tight text-forest"
      >
        Cosas para una vida de agua, pasto y <em
          class="font-medium italic text-forest-mid">siesta</em
        >.
      </h1>
      <p class="m-0 mb-6 max-w-[38rem] text-[1.12rem] text-muted">
        Capycosas arma lo que tu capy usa de verdad: picar, flotar, rascarse y no
        decidir nada. Nada de remeras, tote bags ni souvenirs para la gente.
      </p>
      <div class="mb-5 flex flex-wrap gap-2.5">
        <Button href="#productos">Mirá los productos</Button>
        <Button href="#como-funciona" variant="ghost">Cómo funciona</Button>
      </div>
      <div
        class="flex flex-wrap gap-x-5 gap-y-2.5 text-[0.92rem] text-forest-mid"
      >
        <span><strong class="font-semibold text-forest">6 piezas</strong> pensadas para el animal</span>
        <span><strong class="font-semibold text-forest">USD</strong> · precios de muestra</span>
      </div>
    </div>

    <figure class="relative m-0 max-[720px]:order-1">
      <img
        class="h-[min(68vh,620px)] w-full rounded-[1.4rem_1.4rem_4.5rem_1.4rem] object-cover object-[28%_55%] shadow-[0_18px_40px_rgba(26,51,41,0.08)] max-[720px]:h-[52vw] max-[720px]:min-h-[240px] max-[720px]:rounded-[1.1rem]"
        src="/images/hero.jpg"
        alt="Capibara adulto descansando junto a agua baja, en un patio con pasto y luz de mañana."
        width="952"
        height="514"
        loading="eager"
      />
      <div
        class="absolute -left-[1.1rem] bottom-6 max-w-[15rem] rounded-2xl border border-line bg-paper p-4 shadow-[0_18px_40px_rgba(26,51,41,0.08)] max-[720px]:static max-[720px]:mt-3 max-[720px]:max-w-none max-[900px]:left-3"
      >
        <p class="m-0 font-serif text-[1.05rem] italic leading-snug text-forest">
          Agua baja, pasto largo, sombra. El resto es marketing.
        </p>
        <small
          class="mt-1.5 block text-[0.78rem] uppercase tracking-wide text-muted"
          >Cómo vive un capy</small
        >
      </div>
    </figure>
  </div>
</section>
