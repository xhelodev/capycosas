---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Capycosas — Cosas para capibaras",
  description = "Capycosas hace productos para capibaras: pasto, agua, descanso. No es merch para humanos.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F6F0E6" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,520;0,9..144,620;1,9..144,500;1,9..144,600&family=Outfit:wght@340;420;520;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a
      class="absolute left-4 top-[-4rem] z-20 bg-forest px-3.5 py-2.5 text-paper focus:top-3"
      href="#contenido">Saltar al contenido</a
    >
    <slot />
  </body>
</html>
